    const isHD=!isLKC&&/CTHC/.test(T)&&/H[ỢO]P\s*Đ.{1,2}NG\s*THU/i.test(T);
    if(isHD){
      kinds.push("Hợp đồng"); const p=2;
      if(m=T.match(/Số\s*:\s*(\d{1,3}\s*\/\s*\d{4}\s*\/\s*H[ĐD][\w.]*(?:-\s*[A-Z]+)?)/)) set("soHD",m[1].replace(/\s+/g,""),p);
      if(m=T.match(/vào ngày\s+(\d{1,2})\s+tháng\s+(\d{1,2})\s+năm\s+(\d{4})/i)) set("ngayHD",vnDate(m[1],m[2],m[3]),p);
      if(m=T.match(/BÊN THUÊ\s*\(\s*BÊN B\s*\)\s*:?\s*(?:[-–•]\s*)?(?:Tên\s+[\p{L} ]{2,20}?\s*:\s*)?(.+?)(?:\s*\.?\s*\(\s*Giấy|\s+[-–]?\s*(?:Địa chỉ|Đại diện|Mã số thuế|Điện thoại|Số điện thoại|Tài khoản|Người đại diện))/iu)) set("tenB",fixName(m[1]),p);
      // căn cứ: từ đầu đến trước "Hợp đồng ... được lập"
      let head=T; const cut=T.search(/Hợp đồng thuê công trình hạ tầng kỹ thuật này được lập|BÊN CHO THUÊ/i); if(cut>0) head=T.slice(0,cut);
      const pieces=head.split(/(?=Căn cứ )/).map(x=>x.trim()).filter(x=>/^Căn cứ /.test(x)&&!GENERIC.test(x)).map(x=>x.replace(/[;.\-–\s]+$/,""));
      if(pieces.length){ set("canCu",pieces.join("\n"),p);
        const v=pieces.find(x=>/hạ tầng ngầm/i.test(x)&&/tuyến đường/i.test(x)&&/(đăng ký|thuê)/i.test(x)); 
        if(v&&(m=v.match(/tuyến đường\s+(.+)$/i))) set("tuyen",m[1].replace(/[.\s]+$/,""),p); }
      if(d.blocks){ // bảng Phụ lục 1: tên tuyến chính xác
        const names=[];
        d.blocks.filter(b=>b.type==="tbl").forEach(b=>{const hi=b.rows.findIndex(r=>r.some(c=>/Tên tuyến/i.test(c))&&r.some(c=>/Điểm đầu/i.test(c)));
          if(hi>=0) b.rows.slice(hi+1).forEach(r=>{const n=(r[1]||"").trim(); if(/^\d+$/.test((r[0]||"").trim())&&n&&!/pi\s*ngoi/i.test(n)&&!names.includes(n)) names.push(n);});});
        if(names.length) set("tuyen",names.join(", "),3);
      }
      if(!d.blocks) notes.push(["warn","Hợp đồng scan: ngày ký hợp đồng và căn cứ có thể bị OCR sai chữ, anh đọc lại từng dòng."]);
    }
    if(isLKC){
      kinds.push("Lệnh khởi công"); const p=3;
      if(m=T.match(/Số\s*:\s*(\d+)\s*\/\s*TTHT\s*-?\s*LKC/i)) set("soLKC",m[1],p);
      if(m=T.match(/ngày\s+(\d{1,2})\s+tháng\s+(\d{1,2})\s+năm\s+(\d{4})/i)) set("ngayLKC",vnDate(m[1],m[2],m[3]),p);
      if(m=T.match(/EOFFICE\s*:\s*(\d+)/i)) set("eoffice",m[1],p);
      if(m=T.match(/tại tuyến đường\s+(.+?)\s+trong phạm vi\s+H[ĐD]\s+(\d{1,3}\s*\/\s*\d{4}\s*\/\s*H[ĐD][\w.]*(?:-\s*[A-Z]+)?)(?:\s+ký ngày\s+(\d{1,2}\/\d{1,2}\/\d{4}))?/i)){set("tuyen",m[1],p);set("soHD",m[2].replace(/\s+/g,""),p);set("ngayHD",m[3],p);}
      if(m=T.match(/Kính gửi\s*:\s*(Công ty .+?)\s+Căn cứ/i)) set("tenB",m[1].replace(/[\s.\-–;]+$/,""),p);
      const a=T.search(/Kính gửi/i), b=T.search(/Trung Tâm Hạ Tầng xin thông báo/i);
      if(a>=0&&b>a){const pcs=T.slice(a,b).split(/(?=Căn cứ )/).map(x=>x.trim()).filter(x=>/^Căn cứ /.test(x)&&!/^Căn cứ hợp đồng thuê công trình/i.test(x)).map(x=>x.replace(/[;.\-–\s]+$/,"")); if(pcs.length) set("canCu",pcs.join("\n"),p);}
      if(m=T.match(/thi công từ ngày\s*:?\s*(\d{1,2}\/\d{1,2}\/\d{4})\s*đến\s*(?:ngày\s*)?(\d{1,2}\/\d{1,2}\/\d{4})/i)){set("tc_tu",m[1],p);set("tc_den",m[2],p);}
      if(m=T.match(/cáp quang\s*<\s*(\d+)\s*m/i)) set("bucap",m[1],p);
      if(m=T.match(/trong vòng\s+(\d+)\s+ngày/i)) set("soNgay",m[1],p);
      if(m=T.match(/(Phòng H[ạa] [Tt]ầng\s+[\p{Lu}][\p{L}]*(?:\s+[\p{Lu}][\p{L}]*)?)\s*:\s*Trưởng Phòng\s*:\s*([\p{L} ]+?)\s*[-–]\s*(?:ĐTLL|SĐT)\s*:?\s*([\d. ]+?)\s*[,;-]?\s*[-–]?\s*Phó Phòng\s*:\s*([\p{L} ]+?)\s*[-–]\s*(?:ĐTLL|SĐT)\s*:?\s*(\d+)/u)){
        set("phong",m[1].replace(/\s+/g," ").replace(/Hạ tầng/i,"Hạ Tầng"),p);set("tp",m[2],p);set("tpSdt",m[3].replace(/\s/g,""),p);set("pp",m[4],p);set("ppSdt",m[5],p);}
      else if(m=T.match(/thi công theo hướng dẫn\s+(Phòng [^,]+?)\s*,/i)) set("phong",m[1],p);
      if(m=T.match(/Lưu VT T\.?TH\s*\(([^)]+)\)/i)) set("nguoiSoan",m[1].trim(),p);
      if(d.blocks){ // chữ ký từ bảng cuối
        for(const b of d.blocks.filter(x=>x.type==="tbl")){ const c=(b.rows[0]||[])[1]; if(c&&/GIÁM ĐỐC/.test(c)&&/KT\.|PHÓ|GIÁM/.test(c)){
          const ls=c.split("\n").map(x=>x.trim()).filter(Boolean); const k1=ls.find(x=>/^KT\./i.test(x))||""; const k2=ls.find(x=>/GIÁM ĐỐC/.test(x)&&!/^KT\./i.test(x))||""; const nm=ls[ls.length-1];
          if(k2&&nm&&nm!==k2){set("ky1",k1,p);out.__ky1blank=!k1;set("ky2",k2,p);set("kyTen",nm,p);} } }
      } else { // PDF: chữ ký đọc theo văn bản
        const i=T.search(/EOFFICE/i), tail=i>=0?T.slice(i):T;
        const nm=[...tail.matchAll(/([\p{Lu}][\p{Ll}]+(?:\s+[\p{Lu}][\p{Ll}]+){1,3})/gu)].map(x=>x[1]).find(x=>!/^(Hệ|Tập|ID)\b/.test(x));
        if(nm){ set("kyTen",nm,p); const kt=/KT\.?\s*GIÁM ĐỐC/i.test(tail), pho=/PHÓ GIÁM ĐỐC/i.test(tail); set("ky2",pho?"PHÓ GIÁM ĐỐC":"GIÁM ĐỐC",p); if(kt) set("ky1","KT.GIÁM ĐỐC",p); else out.__ky1blank=true; }
      }
    }
    notes.unshift([kinds.length?"ok":"warn",`${d.name}: ${kinds.length?"nhận diện là "+kinds.join(", "):"không nhận diện được (cần Hợp đồng hoặc Lệnh khởi công cũ)"}`]);
  }
  return {fields:out,notes};
}
function applyParsed({fields:f,notes}){
  const filled=[]; if(f.__ky1blank){S.ky1="";} delete f.__ky1blank;
  Object.entries(f).forEach(([k,v])=>{ if(S[k]!==v){S[k]=v;filled.push(k);} });
  return {filled,notes};
}
async function handleFiles(files){
  const list=[...files].filter(f=>/\.(pdf|docx)$/i.test(f.name)||f.type==="application/pdf"); if(!list.length) return;
  logEl.innerHTML=""; const docs=[];
  for(const f of list){
    log("Đang đọc "+f.name+"…");
    try{
      if(/\.docx$/i.test(f.name)){const r=await readDocx(f); docs.push({name:f.name,text:r.text,blocks:r.blocks}); log(`  ${f.name}: ${norm(r.text).length} ký tự (Word)`,"ok");}
      else{const r=await readPdf(f,$("#cOcr").checked); r.text=r.text.replace(/(\d)[ \t]+(?=\d)/g,"$1").replace(/[ \t]*\/[ \t]*/g,"/"); docs.push({name:f.name,text:r.text}); log(`  ${f.name}: ${norm(r.text).length} ký tự${r.usedOcr?" (qua OCR)":""}`,norm(r.text).length>40?"ok":"warn");}
    }catch(e){log(`  Lỗi đọc ${f.name}: ${e.message}`,"bad");}
  }
  $("#raw").textContent=docs.map(d=>"=== "+d.name+" ===\n"+d.text).join("\n\n");
  const res=applyParsed(parseDocs(docs)); res.notes.forEach(([c,m])=>log(m,c));
  if(PHONG[S.phong]&&!docs.some(d=>/Trưởng Phòng/.test(d.text))){const q=PHONG[S.phong]; Object.assign(S,q);}
  log(res.filled.length?"Đã điền: "+[...new Set(res.filled)].join(", ")+". Anh kiểm tra lại các ô bên dưới.":"Không tìm thấy trường nào để điền, anh nhập tay giúp.",res.filled.length?"ok":"warn");
  persist(); bindStatic();
}
const drop=$("#drop");
$("#bPick").onclick=()=>$("#fPdf").click();
$("#fPdf").onchange=e=>handleFiles(e.target.files);
["dragenter","dragover"].forEach(ev=>drop.addEventListener(ev,e=>{e.preventDefault();drop.classList.add("on");}));
["dragleave","drop"].forEach(ev=>drop.addEventListener(ev,e=>{e.preventDefault();drop.classList.remove("on");}));
drop.addEventListener("drop",e=>handleFiles(e.dataTransfer.files));
$("#bSave").onclick=()=>{const a=document.createElement("a");a.href=URL.createObjectURL(new Blob([JSON.stringify(S,null,1)],{type:"application/json"}));a.download="LKC_"+(slug(S.soLKC)||"du-lieu")+".json";a.click();};
$("#bLoad").onclick=()=>$("#fLoad").click();
$("#fLoad").onchange=async e=>{const f=e.target.files[0];if(!f)return;try{S=Object.assign(BLANK(),JSON.parse(await f.text()));persist();bindStatic();}catch(x){alert("File không hợp lệ");}};
$("#bReset").onclick=()=>{if(confirm("Xóa toàn bộ dữ liệu đang nhập?")){S=BLANK();persist();bindStatic();logEl.innerHTML="";}};
restore(); buildStatic(); bindStatic();

</script>
