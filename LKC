  const f=zip.file("word/document.xml"); if(!f) throw new Error("Không phải file Word hợp lệ");
  const doc=new DOMParser().parseFromString(await f.async("string"),"application/xml");
  const body=doc.getElementsByTagNameNS(W,"body")[0];
  const pText=p=>{let t="";
    const walk=n=>{for(const c of n.childNodes){ if(c.nodeType!==1) continue; const ln=c.localName;
      if(c.namespaceURI===W){ if(ln==="t") t+=c.textContent; else if(ln==="tab") t+=" "; else if(ln==="br"||ln==="cr") t+=" ";
        else if(ln==="txbxContent"||ln==="del"||ln==="instrText") continue; else walk(c);} else if(ln!=="Fallback") walk(c);} };
